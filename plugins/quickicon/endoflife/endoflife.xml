<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="quickicon" method="upgrade">
	<name>plg_quickicon_endoflife</name>	
	<author>Joomla! Project</author>
	<creationDate>2024-11</creationDate>
	<copyright>(C) 2024 Open Source Matters, Inc.</copyright>
	<license>GNU General Public License version 2 or later; see LICENSE.txt</license>
	<authorEmail>admin@joomla.org</authorEmail>
	<authorUrl>www.joomla.org</authorUrl>
	<version>1.0.0</version>
	<description>PLG_QUICKICON_ENDOFLIFE_XML_DESCRIPTION</description>	
	<namespace path="src">Joomla\Plugin\Quickicon\EndOfLife</namespace>
	<media folder="media" destination="plg_quickicon_endoflife">
		<folder>js</folder>
	</media>
	<files>
		<folder plugin="endoflife">services</folder>
		<folder>src</folder>
	</files>	
	<languages>
	   <language tag="en-GB">language/en-GB/plg_quickicon_endoflife.ini</language>
	   <language tag="en-GB">language/en-GB/plg_quickicon_endoflife.sys.ini</language>
	</languages>	
	<config>
		<fields name="params">
			<fieldset name="basic">							
				<field
					name="context"
					type="text"								
					label="PLG_QUICKICON_ENDOFLIFE_GROUP_LABEL"
					description="PLG_QUICKICON_ENDOFLIFE_GROUP_DESC"
					default="update_quickicon"
				/>
			</fieldset>
		</fields>
	</config>
</extension>
