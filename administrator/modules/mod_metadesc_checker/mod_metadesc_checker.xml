<?xml version="1.0" encoding="utf-8"?>
<extension type="module" client="administrator" method="upgrade">
    <name>mod_metadesc_checker</name>
    <author>Your Name</author>
    <creationDate>March 2025</creationDate>
    <copyright>Copyright (C) 2023 Your Name. All rights reserved.</copyright>
    <license>GNU General Public License version 2 or later</license>
    <authorEmail>your.email@example.com</authorEmail>
    <authorUrl>www.example.com</authorUrl>
    <version>1.0.0</version>
    <description>MOD_METADESC_CHECKER_XML_DESCRIPTION</description>
    
    <files>
        <filename module="mod_metadesc_checker">mod_metadesc_checker.php</filename>
        <filename>helper.php</filename>
        <folder>tmpl</folder>
        <folder>language</folder>
    </files>
    
    <languages>
        <language tag="en-GB">language/en-GB/en-GB.mod_metadesc_checker.ini</language>
        <language tag="en-GB">language/en-GB/en-GB.mod_metadesc_checker.sys.ini</language>
    </languages>
    
    <config>
        <fields name="params">
            <fieldset name="basic">
                <field
                    name="check_keywords"
                    type="radio"
                    label="MOD_METADESC_CHECKER_CHECK_KEYWORDS_LABEL"
                    description="MOD_METADESC_CHECKER_CHECK_KEYWORDS_DESC"
                    default="0"
                    layout="joomla.form.field.radio.switcher"
                    filter="integer"
                    >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                
                <field
                    name="published_only"
                    type="radio"
                    label="MOD_METADESC_CHECKER_PUBLISHED_ONLY_LABEL"
                    description="MOD_METADESC_CHECKER_PUBLISHED_ONLY_DESC"
                    default="1"
                    layout="joomla.form.field.radio.switcher"
                    filter="integer"
                    >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
            </fieldset>
            
            <fieldset name="advanced">
                <field
                    name="layout"
                    type="modulelayout"
                    label="JFIELD_ALT_LAYOUT_LABEL"
                    description="JFIELD_ALT_MODULE_LAYOUT_DESC"
                />

                <field
                    name="moduleclass_sfx"
                    type="textarea"
                    label="COM_MODULES_FIELD_MODULECLASS_SFX_LABEL"
                    description="COM_MODULES_FIELD_MODULECLASS_SFX_DESC"
                    rows="3"
                />

                <field
                    name="cache"
                    type="list"
                    label="COM_MODULES_FIELD_CACHING_LABEL"
                    description="COM_MODULES_FIELD_CACHING_DESC"
                    default="1"
                    filter="integer"
                    >
                    <option value="1">JGLOBAL_USE_GLOBAL</option>
                    <option value="0">COM_MODULES_FIELD_VALUE_NOCACHING</option>
                </field>

                <field
                    name="cache_time"
                    type="number"
                    label="COM_MODULES_FIELD_CACHE_TIME_LABEL"
                    description="COM_MODULES_FIELD_CACHE_TIME_DESC"
                    default="900"
                    filter="integer"
                />
            </fieldset>
        </fields>
    </config>
</extension>